diff --git a/CMakeLists.txt b/CMakeLists.txt
index d2c8913..4c93f85 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1,5 +1,10 @@
 cmake_minimum_required(VERSION 3.22)
 
+get_filename_component(app_source "${CMAKE_CURRENT_LIST_DIR}" REALPATH)
+add_subdirectory("${app_source}/../aap-juce" "${CMAKE_CURRENT_BINARY_DIR}/aap-juce" EXCLUDE_FROM_ALL)
+aap_juce_configure(JUCE_SOURCE_DIR ../JUCE ICON Source/UI/Images/icon.png ADOPT_EXISTING_PATCHES)
+
+
 if(APPLE)
     set(CMAKE_OSX_DEPLOYMENT_TARGET "11.0" CACHE STRING "Minimum macOS deployment version" FORCE)
 endif()
@@ -118,3 +123,50 @@ if(MSVC)
     target_link_options(Altar_VST3 PRIVATE /INCREMENTAL:NO)
     target_link_options(Altar_Standalone PRIVATE /INCREMENTAL:NO)
 endif()
+
+# begin AAP specifics -->
+
+# They are needed in desktop too, for generate-aap-metadata.
+target_include_directories(Altar PUBLIC
+        "${AAP_DIR}/include"
+        "${AAP_JUCE_DIR}/aap-modules"
+)
+
+target_compile_definitions(Altar PUBLIC
+        JUCEAAP_HAVE_AUDIO_PLAYHEAD_NEW_POSITION_INFO=1
+        JUCE_PUSH_NOTIFICATIONS=1
+        JUCE_PUSH_NOTIFICATIONS_ACTIVITY="com/rmsl/juce/JuceActivity"
+)
+
+message("AAP_DIR: ${AAP_DIR}")
+message("AAP_JUCE_DIR: ${AAP_JUCE_DIR}")
+juce_add_modules(${AAP_JUCE_DIR}/aap-modules/aap_audio_processors)
+
+if (ANDROID)
+    find_library(log "log")
+    find_library(android "android")
+    find_library(glesv2 "GLESv2")
+    find_library(egl "EGL")
+    find_package(androidaudioplugin CONFIG REQUIRED)
+    #set(cpufeatures_lib "cpufeatures")
+    #set(oboe_lib "oboe")
+
+    target_include_directories(Altar PRIVATE
+            "${ANDROID_NDK}/sources/android/cpufeatures"
+            #"${OBOE_DIR}/include"
+    )
+
+    target_link_libraries(Altar PRIVATE
+            androidaudioplugin::androidaudioplugin
+            aap_audio_processors
+    )
+
+    add_compile_definitions(
+            [[JUCE_ANDROID=1]]
+            [[JUCE_DONT_AUTO_OPEN_MIDI_DEVICES_ON_MOBILE=1]]
+    )
+endif (ANDROID)
+
+target_link_libraries(Altar PRIVATE aap_audio_processors)
+
+# <-- end AAP specifics
